{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spatializer:schema:spatial_scene_package:0.1",
  "title": "Spatial Scene Package 0.1 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "package_id",
    "timebase",
    "coordinate_system",
    "source",
    "room",
    "zones",
    "extensions"
  ],
  "properties": {
    "format": {"const": "spatial_scene_package"},
    "version": {"const": "0.1"},
    "package_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate", "frame_count"],
      "properties": {
        "sample_rate": {"const": 48000},
        "frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "azimuth_zero",
        "positive_azimuth",
        "positive_elevation",
        "distance_unit"
      ],
      "properties": {
        "reference": {"const": "listener"},
        "azimuth_zero": {"const": "front"},
        "positive_azimuth": {"const": "left"},
        "positive_elevation": {"const": "up"},
        "distance_unit": {"const": "metre"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "extractor_revision", "source_sha256", "profile_sha256"],
      "properties": {
        "kind": {"const": "stereo_seven_zone"},
        "extractor_revision": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "early_reflection_level_db",
        "late_reverb_level_db",
        "late_rt60_s"
      ],
      "properties": {
        "early_reflection_level_db": {"type": "number", "minimum": -40, "maximum": -10},
        "late_reverb_level_db": {"type": "number", "minimum": -40, "maximum": -12},
        "late_rt60_s": {"type": "number", "minimum": 0.15, "maximum": 1.2}
      }
    },
    "zones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bass",
        "center_anchor",
        "front_L_residual",
        "front_R_residual",
        "side_width",
        "rear_ambience",
        "high_air"
      ],
      "properties": {
        "bass": {
          "allOf": [
            {"$ref": "#/$defs/objectZone"},
            {"properties": {"role": {"const": "bass"}}}
          ]
        },
        "center_anchor": {
          "allOf": [
            {"$ref": "#/$defs/objectZone"},
            {"properties": {"role": {"const": "center"}}}
          ]
        },
        "front_L_residual": {
          "allOf": [
            {"$ref": "#/$defs/objectZone"},
            {"properties": {"role": {"const": "front"}}}
          ]
        },
        "front_R_residual": {
          "allOf": [
            {"$ref": "#/$defs/objectZone"},
            {"properties": {"role": {"const": "front"}}}
          ]
        },
        "side_width": {
          "allOf": [
            {"$ref": "#/$defs/fieldZone"},
            {"properties": {"role": {"const": "width"}}}
          ]
        },
        "rear_ambience": {
          "allOf": [
            {"$ref": "#/$defs/fieldZone"},
            {"properties": {"role": {"const": "ambience"}}}
          ]
        },
        "high_air": {
          "allOf": [
            {"$ref": "#/$defs/fieldZone"},
            {"properties": {"role": {"const": "air"}}}
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "additionalProperties": {"type": "object"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "audioReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^audio/(?!.*\\.\\.)[A-Za-z0-9_.-]+\\.wav$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "objectKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_offset",
        "interpolation",
        "gain_db",
        "azimuth_deg",
        "elevation_deg",
        "distance_m",
        "size",
        "diffusion",
        "direct_ratio",
        "early_reflection_trim_db",
        "late_reverb_trim_db"
      ],
      "properties": {
        "sample_offset": {"type": "integer", "minimum": 0},
        "interpolation": {"enum": ["hold", "linear"]},
        "gain_db": {"type": "number", "minimum": -24, "maximum": 12},
        "azimuth_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "elevation_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "distance_m": {"type": "number", "minimum": 0.1, "maximum": 10},
        "size": {"type": "number", "minimum": 0, "maximum": 1},
        "diffusion": {"type": "number", "minimum": 0, "maximum": 1},
        "direct_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "early_reflection_trim_db": {"type": "number", "minimum": -18, "maximum": 12},
        "late_reverb_trim_db": {"type": "number", "minimum": -18, "maximum": 12}
      }
    },
    "fieldKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_offset",
        "interpolation",
        "gain_db",
        "azimuth_deg",
        "elevation_deg"
      ],
      "properties": {
        "sample_offset": {"type": "integer", "minimum": 0},
        "interpolation": {"enum": ["hold", "linear"]},
        "gain_db": {"type": "number", "minimum": -120, "maximum": 6},
        "azimuth_deg": {"type": "number", "minimum": 0, "maximum": 180},
        "elevation_deg": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "objectZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "audio", "keyframes"],
      "properties": {
        "kind": {"const": "object"},
        "role": {"type": "string"},
        "audio": {"$ref": "#/$defs/audioReference"},
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/objectKeyframe"}
        }
      }
    },
    "fieldZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "field_mode", "audio", "keyframes"],
      "properties": {
        "kind": {"const": "mirrored_field"},
        "role": {"type": "string"},
        "field_mode": {"const": "mirrored_opposite_polarity"},
        "audio": {"$ref": "#/$defs/audioReference"},
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fieldKeyframe"}
        }
      }
    }
  }
}
